  nombre
  telefono
  getNombre()
}

class Bolsin <<entity>> {
  fecha
  numeroBolsin
  numeroPrecinto
  peso
  asociarRemito()
  crearCEBolsin()
  esTuCMOrigen()
  getNroPrecinto()
  getNumeroBolsin()
  mostrarDatos()
  new()
  obtenerCMDestino()
  obtenerInformacionRemito()
  setDetalleBolsin()
  sosEnviado()
  agregarRemito()
  eliminar()
  cerrar()
  romperPrecinto()
  eliminar()
  finJornadaLaboral()
  retirado()
  recibir()
}

class Remito <<entity>> {
  fecha
  numero
  actualizarEstadoDoc()
  buscarDocumentacion()
  estasGenerado()
  getDatosRemito()
  getNumero()
  modificarDocumentacionIncluida()
  mostrarInformacionRemito()
  new()
  setEstado()
  setEstado()
  tenesEstaCMDestino()
  tenesEstaCMOrigen()
  tomarDocumentacion()
  agregarDocumentacion()
  agregarABolsin()
  cancelar()
  quitarDeBolsin()
  retirarBolsin()
  recibir()
}

class CambioEstadoBolsin <<entity>> {
  fechaHoraFin
  fechaHoraInicio
  new()
  setFechaHoraFin()
  sosActual()
  sosEnviado()
}

class Estado <<entity>> {
  ambito
  descripcion
  nombre
  esAmbitoBolsin()
  esAmbitoDocumentacion()
  esAmbitoRemito()
  esEnviado()
  esRecibidaYAceptada()
  esRecibidoENCMCDestino()
