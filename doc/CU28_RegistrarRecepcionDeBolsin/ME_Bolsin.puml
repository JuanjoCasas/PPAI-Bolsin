@startuml "Maquina de estado del Bolsin"
hide empty description

[*] --> creado : new()
creado -> creado : agregarRemitos()
creado -> deBaja : eliminar()
creado --> cerrado : cerrar()

cerrado -> creado : romperPrecinto()
cerrado -> deBaja : eliminar()
cerrado --> pendienteDeRetiro : finJornadaLaboral()

pendienteDeRetiro -> enviado : retirado()

state "Recibido en CM destino" as recibido
enviado -> recibido : recibir()

deBaja -> [*]
recibido -> [*]

note right of creado #FFCCCC
    REVISAR
    Inicialmente este estado era EnPreparacion.
    Luego de leer las ERS se interpretó que:
      - Es el estado inicial real
      - Aún no hay armado de bolsín
    Se renombra a creado.
    Está correcta la interpretación?
end note

@enduml
